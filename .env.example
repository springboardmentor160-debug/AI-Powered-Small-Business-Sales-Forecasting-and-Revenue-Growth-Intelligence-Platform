# MarketMind AI — Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT commit the .env file with real secrets to version control.

# Application Environment
ENVIRONMENT=production
PORT=8000

# Backend Security (JWT)
# Generate a secure 32+ character random string for production
JWT_SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./db/marketmind.db
# PostgreSQL alternative for production cloud databases:
# DATABASE_URL=postgresql://user:password@host:5432/marketmind

# Frontend API Configuration (leave blank for local reverse-proxy in Docker)
# For decoupled cloud deployments (e.g. Vercel frontend + Render backend):
# VITE_API_URL=https://marketmind-backend.onrender.com
VITE_API_URL=
