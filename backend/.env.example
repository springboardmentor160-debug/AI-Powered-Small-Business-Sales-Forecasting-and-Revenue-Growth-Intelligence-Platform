# Copy to backend/.env (Windows CMD:  copy .env.example .env).  Never commit the real .env.
# SQLite: leave DATABASE_URL empty to use <project>/data/marketmind.db (an absolute path is derived automatically).
DATABASE_URL=
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_HOURS=8
# init_db.py creates this admin if it does not exist yet - choose your own password
ADMIN_EMAIL=admin@marketmind.local
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Forgot password e-mail ------------------------------------------------------------------------------
# Leave SMTP_HOST empty to try it locally: no e-mail is sent, the reset link is PRINTED in the backend console
# (and saved in data/outbox/). Fill these in to send real e-mail. Gmail example: smtp.gmail.com / 587 / starttls,
# SMTP_USER = your address, SMTP_PASSWORD = a Google "App password" (needs 2-step verification), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Address of the dashboard, used to build the link inside the e-mail
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30

# ---- Administrator sign-up on the login page ------------------------------------------------------------
# People who pick "Administrator" when registering must type this code. Choose your own secret; EMPTY = admin sign-up disabled.
ADMIN_REGISTRATION_CODE=

# ---- Recent dates ---------------------------------------------------------------------------------------
# The sample data ends on 2024-01-01. 1 = show every date moved forward so the newest record is today (so "Last 30 days" is
# recent). 0 = show the real dates.
REBASE_DATES_TO_TODAY=1
